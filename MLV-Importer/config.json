{
    "Version": 2,

    "Destinations": {
        "Photos": "D:\\Camera Import\\Photos",
        "MLV": "D:\\Camera Import\\MLV"
    },

    "Organization": {
        "Mode": "PreserveSourceFolders",

        "AvailableModes": [
            "PreserveSourceFolders",
            "ByCard",
            "ByDate",
            "ByDateAndCard"
        ],

        "DateFormat": "yyyy-MM-dd"
    },

    "FileTypes": {
        "Photos": [
            ".CR2",
            ".CR3",
            ".JPG",
            ".JPEG",
            ".JPE",
            ".PNG",
            ".TIFF",
            ".TIF"
        ],

        "MLVMain": [
            ".MLV"
        ],

        "MLVChunks": {
            "Enabled": true,
            "Pattern": "^\\.M[0-9]{2}$"
        }
    },

    "Scanning": {
        "ScanSubfolders": true,

        "IgnoreFolders": [
            "System Volume Information",
            "$RECYCLE.BIN"
        ],

        "MinimumCameraFiles": 1,

        "RequireCameraFolderHint": false,

        "CameraFolderHints": [
            "DCIM",
            "ML",
            "MISC"
        ]
    },

    "Copy": {
        "SkipExistingSameSize": true,

        "ReplaceDifferentSize": false,

        "UseTemporaryFiles": true,

        "TemporaryExtension": ".importing",

        "Retries": 3,

        "RetryDelaySeconds": 3,

        "BufferSizeMB": 8
    },

    "Verification": {
        "Enabled": true,

        "Method": "Size",

        "AvailableMethods": [
            "None",
            "Size",
            "SHA256"
        ]
    },

    "Stability": {
        "Enabled": true,

        "Checks": 2,

        "DelaySeconds": 3
    },

    "Performance": {
        "ParallelPhotoCopies": 2,

        "ParallelMLVCopies": 1
    },

    "Monitoring": {
        "PollIntervalSeconds": 2,

        "MountSettleSeconds": 3,

        "RescanAfterImportSeconds": 2
    },

    "Card": {
        "OnlyRemovableDrives": true,

        "AutoEject": false,

        "EjectDelaySeconds": 2
    },

    "Safety": {
        "DryRun": false,

        "NeverDeleteSource": true,

        "NeverMoveSource": true
    },

    "Manifest": {
        "Enabled": true,

        "Directory": "manifests"
    },

    "Logging": {
        "Enabled": true,

        "Directory": "logs",

        "FileName": "importer.log",

        "KeepDays": 30
    },

    "Notifications": {
        "Enabled": true,

        "OnCardDetected": true,

        "OnImportComplete": true,

        "OnError": true
    }
}