{
    "Version":  4,
    "Destinations":  {
                         "Photos":  "D:\\Camera\\Photos",
                         "MLV":  "D:\\Camera\\MLV"
                     },
    "Organization":  {
                         "Mode":  "ByDate",
                         "AvailableModes":  ["ByDate", "Flat"],
                         "DateFormat":  "yyyy-MM-dd"
                     },
    "FileTypes":  {
                      "Photos":  [
                                     ".CR2",
                                     ".CR3",
                                     ".JPG",
                                     ".JPEG",
                                     ".JPE",
                                     ".PNG",
                                     ".TIF",
                                     ".TIFF"
                                 ],
                      "MLVMain":  [
                                      ".MLV"
                                  ],
                      "MLVChunks":  {
                                        "Enabled":  true,
                                        "Pattern":  "^\\.M[0-9]{2}$"
                                    }
                  },
    "Scanning":  {
                     "ScanSubfolders":  true,
                     "IgnoreFolders":  [
                                           "System Volume Information",
                                           "$RECYCLE.BIN"
                                       ],
                     "MinimumCameraFiles":  1
                 },
    "Copy":  {
                 "SkipExistingSameSize":  true,
                 "ReplaceDifferentSize":  false,
                 "UseTemporaryFiles":  true,
                 "TemporaryExtension":  ".importing",
                 "Retries":  3,
                 "RetryDelaySeconds":  3
             },
    "Verification":  {
                         "Enabled":  true,
                         "Method":  "Size",
                         "AvailableMethods":  ["None", "Size", "SHA256"]
                     },
    "Stability":  {
                      "Enabled":  true,
                      "Checks":  2,
                      "DelaySeconds":  2
                  },
    "Monitoring":  {
                       "PollIntervalSeconds":  2,
                       "MountSettleSeconds":  3
                   },
    "Card":  {
                 "OnlyRemovableDrives":  true,
                 "AutoEject":  false,
                 "EjectDelaySeconds":  2,
                 "DeleteSourceAfterImport":  false,
                 "RequireDeleteConfirmation":  true
             },
    "Safety":  {
                   "DryRun":  false,
                   "NeverDeleteUnlessVerified":  true,
                   "NeverMoveSource":  true
               },
    "Manifest":  {
                     "Enabled":  true,
                     "Directory":  "manifests"
                 },
    "Logging":  {
                    "Enabled":  true,
                    "Directory":  "logs",
                    "FileName":  "importer.log",
                    "KeepDays":  30
                },
    "Notifications":  {
                          "Enabled":  true,
                          "OnCardDetected":  true,
                          "OnImportComplete":  true,
                          "OnError":  true
                      },
    "MLVFS":  {
                  "Enabled":  true,
                  "ControllerPath":  "C:\\MLVScripts\\RightClickMountFolder\\MLV_Controller.bat",
                  "DriveLetter":  "Z:\\"
              }
}