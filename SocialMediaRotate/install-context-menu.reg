Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.mov\shell\ConvertWithFFmpeg]
@="Rotate and add 16:9 with FFmpeg"
"Icon"="C:\\MLVScripts\\ffmpeg_convert\\ffmpeg.exe"

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.mov\shell\ConvertWithFFmpeg\command]
@="powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"C:\\MLVScripts\\ffmpeg_convert\\convert-video.ps1\" \"%1\""

