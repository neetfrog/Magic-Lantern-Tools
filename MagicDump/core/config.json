{
    "Version":  4,
    "Destinations":  {
                         "Photos":  "E:\\!Pictures\\!Dump",
                         "MLV":  "E:\\!MLV"
                     },
    "Organization":  {
                         "Mode":  "Flat",
                         "AvailableModes":  [
                                                "ByDate",
                                                "Flat"
                                            ],
                         "DateFormat":  "yyyy-MM-dd",
                         "MLVMode":  "ByDate",
                         "PhotoMode":  "ByDate"
                     },
    "FileTypes":  {
                      "Photos":  [
                                     ".CR2",
                                     ".CR3",
                                     ".JPG",
                                     ".JPEG",
                                     ".JPE",
                                     ".PNG",
                                     ".TIF",
                                     ".TIFF"
                                 ],
                      "MLVMain":  [
                                      ".MLV"
                                  ],
                      "MLVChunks":  {
                                        "Enabled":  true,
                                        "Pattern":  "^\\.M[0-9]+$"
                                    }
                  },
    "Scanning":  {
                     "ScanSubfolders":  true,
                     "IgnoreFolders":  [
                                           "System Volume Information",
                                           "$RECYCLE.BIN"
                                       ],
                     "MinimumCameraFiles":  1
                 },
    "Copy":  {
                 "SkipExistingSameSize":  true,
                 "ReplaceDifferentSize":  false,
                 "UseTemporaryFiles":  false,
                 "TemporaryExtension":  ".importing",
                 "Retries":  1,
                 "RetryDelaySeconds":  1
             },
    "Verification":  {
                         "Enabled":  false,
                         "Method":  "None",
                         "AvailableMethods":  [
                                                  "None",
                                                  "Size",
                                                  "SHA256"
                                              ]
                     },
    "Stability":  {
                      "Enabled":  false,
                      "Checks":  1,
                      "DelaySeconds":  1
                  },
    "Monitoring":  {
                       "PollIntervalSeconds":  1,
                       "MountSettleSeconds":  1
                   },
    "Card":  {
                 "OnlyRemovableDrives":  true,
                 "AutoEject":  true,
                 "EjectDelaySeconds":  2,
                 "DeleteSourceAfterImport":  true,
                 "RequireDeleteConfirmation":  false
             },
    "Safety":  {
                   "DryRun":  false,
                   "NeverDeleteUnlessVerified":  false,
                   "NeverMoveSource":  true
               },
    "Manifest":  {
                     "Enabled":  true,
                     "Directory":  "manifests"
                 },
    "Logging":  {
                    "Enabled":  true,
                    "Directory":  "logs",
                    "FileName":  "importer.log",
                    "KeepDays":  30
                },
    "Notifications":  {
                          "Enabled":  true,
                          "OnCardDetected":  true,
                          "OnImportComplete":  true,
                          "OnError":  true
                      },
    "MLVFS":  {
                  "Enabled":  true,
                  "ControllerPath":  "C:\\MLVScripts\\RightClickMountFolder\\MLV_Controller.bat",
                  "DriveLetter":  "Z:\\"
              },
    "MLVApp":  {
                   "Enabled":  true,
                   "ExecutablePath":  "C:\\MLVScripts\\MLVApp\\MLVApp.exe"
               }
}
